# Copy to .env.local for local overrides (never commit .env.local).
# Development defaults to the local APIs; a production build REQUIRES both, over https.

# Platform API (Gecko.Api): /auth/* login + tokens, /api/* branches and master data
PLATFORM_API_ORIGIN=http://localhost:5100

# Fleet API (Gecko.Fleet.Api): /api/fleet/*
FLEET_API_ORIGIN=http://localhost:5300

# Optional, development only: pre-fill the login form (a production build drops these)
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=admin@sct-test.example
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
